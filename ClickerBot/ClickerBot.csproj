<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClickerBot</AssemblyName>
    <RootNamespace>ClickerBot</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Matches the manifest. Left unset, ApplicationConfiguration.Initialize() asks for
         SystemAware, which contradicts the PerMonitorV2 the manifest already applied. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The compiled .exe's own icon — what Explorer, the taskbar pin, and Alt-Tab show
         before the process is even running. AppIcon.cs draws the same mark live at
         runtime, because that copy also needs to relight when a run starts; this one
         can't, since nothing is running yet, so it's baked from the idle (unlit) state. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
