* text=auto

*.cs        text diff=csharp
*.csproj    text
*.manifest  text
*.json      text
*.md        text

# Windows scripts must keep CRLF endings.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Shell scripts must keep LF endings.
*.sh        text eol=lf

*.png       binary
*.jpg       binary
*.ico       binary
*.dll       binary
*.exe       binary
